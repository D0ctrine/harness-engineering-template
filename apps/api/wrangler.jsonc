{
  "name": "juyaro-bible-api",
  "main": "src/worker.ts",
  "compatibility_date": "2026-03-28",
  "assets": {
    "directory": "../web/public",
    "binding": "ASSETS"
  }
  // After creating the Cloudflare D1 database, add a comma after `assets`, then:
  // "d1_databases": [
  //   {
  //     "binding": "DB",
  //     "database_name": "juyaro-bible",
  //     "database_id": "<database-id>",
  //     "migrations_dir": "migrations"
  //   }
  // ]
}
