{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "baseUrl": ".",
    "paths": {
      "@harness/application": ["packages/application/src/index.ts"],
      "@harness/application/*": ["packages/application/src/*"],
      "@harness/domain": ["packages/domain/src/index.ts"],
      "@harness/domain/*": ["packages/domain/src/*"],
      "@harness/infrastructure": ["packages/infrastructure/src/index.ts"],
      "@harness/infrastructure/*": ["packages/infrastructure/src/*"],
      "@harness/shared": ["packages/shared/src/index.ts"],
      "@harness/shared/*": ["packages/shared/src/*"]
    }
  }
}
