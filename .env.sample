# Copy this file to .env and fill in values per environment.
# Root-level env variables are consumed by both apps through shared config loaders.

# Runtime
NODE_ENV=development
LOG_LEVEL=info

# Frontend
NEXT_PUBLIC_APP_NAME=Harness Engineering Template
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api

# Backend
API_PORT=4000
API_PREFIX=/api
CORS_ORIGIN=http://localhost:3000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/harness_template

# Security
JWT_SECRET=replace-with-long-random-secret
