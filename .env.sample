# Copy this file to .env and fill in values per environment.
# Root-level env variables are consumed by both apps through shared config loaders.

# Runtime
NODE_ENV=development
LOG_LEVEL=info

# Frontend
NEXT_PUBLIC_APP_NAME=Juyaro Bible Project
NEXT_PUBLIC_APP_SHORT_NAME=Juyaro
NEXT_PUBLIC_APP_DESCRIPTION=모바일 중심 QT 읽기, 메모, 묵상, 그룹 나눔을 하나의 설치형 PWA로 제공합니다.
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api

# Backend
API_PORT=4000
API_PREFIX=/api
CORS_ORIGIN=http://localhost:3000
WEB_APP_BASE_URL=http://localhost:3000
API_PUBLIC_BASE_URL=http://localhost:4000/api
SCRIPTURE_ASSET_BASE_URL=http://localhost:3000/scripture
DATABASE_URL=postgres://postgres:postgres@localhost:5432/harness_template

# Security
JWT_SECRET=replace-with-long-random-secret

# Cloudflare Worker OAuth secrets
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
KAKAO_OAUTH_CLIENT_ID=
KAKAO_OAUTH_CLIENT_SECRET=
NAVER_OAUTH_CLIENT_ID=
NAVER_OAUTH_CLIENT_SECRET=
